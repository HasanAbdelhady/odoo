<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="account_edi.action_open_edi_documents" model="ir.actions.act_window">
      <field name="name">Electronic invoicing</field>
      <field name="res_model">account.edi.document</field>
      <field name="view_mode">list</field>
      <field name="domain">[('move_id', '=', active_id), ('error', '!=', False)]</field>
    </record>
    <record id="view_out_invoice_tree_inherit" model="ir.ui.view">
      <field name="name">account.move.list.inherit</field>
      <field name="model">account.move</field>
      <field name="inherit_id" ref="account.view_out_invoice_tree"/>
      <field name="arch" type="xml">
        <field name="status_in_payment" position="before">
          <field class="fw-bold" decoration-danger="edi_blocking_level == 'error'" decoration-muted="edi_blocking_level == 'info'" decoration-warning="edi_blocking_level == 'warning'" name="edi_state" optional="hide"/>
          <field name="edi_blocking_level" optional="hide"/>
          <field name="edi_error_message" optional="hide"/>
        </field>
      </field>
    </record>
    <record id="view_out_credit_note_tree_inherit" model="ir.ui.view">
      <field name="name">account.move.list.inherit</field>
      <field name="model">account.move</field>
      <field name="inherit_id" ref="account.view_out_credit_note_tree"/>
      <field name="arch" type="xml">
        <field name="status_in_payment" position="before">
          <field name="edi_state" optional="hide"/>
          <field name="edi_blocking_level" optional="hide"/>
          <field name="edi_error_message" optional="hide"/>
        </field>
      </field>
    </record>
    <record id="view_in_invoice_refund_tree_inherit" model="ir.ui.view">
      <field name="name">account.move.list.inherit</field>
      <field name="model">account.move</field>
      <field name="inherit_id" ref="account.view_in_invoice_refund_tree"/>
      <field name="arch" type="xml">
        <field name="status_in_payment" position="before">
          <field name="edi_state" optional="hide"/>
          <field name="edi_blocking_level" optional="hide"/>
          <field name="edi_error_message" optional="hide"/>
        </field>
      </field>
    </record>
    <record id="view_in_bill_tree_inherit" model="ir.ui.view">
      <field name="name">account.move.tree.inherit</field>
      <field name="model">account.move</field>
      <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
      <field name="arch" type="xml">
        <field name="status_in_payment" position="before">
          <field name="edi_state" optional="hide"/>
          <field name="edi_blocking_level" optional="hide"/>
          <field name="edi_error_message" optional="hide"/>
        </field>
      </field>
    </record>
    <record id="view_account_invoice_filter" model="ir.ui.view">
      <field name="name">account.invoice.select.inherit</field>
      <field name="model">account.move</field>
      <field name="inherit_id" ref="account.view_account_invoice_filter"/>
      <field name="arch" type="xml">
        <xpath expr="//search/group/filter[@name='status']" position="after">
          <filter context="{'group_by': 'edi_state'}" groups="base.group_no_one" name="edi_state" string="Electronic invoicing state"/>
          <separator/>
          <filter domain="[('edi_state', 'in', [('to_send'), ('to_cancel')])]" groups="base.group_no_one" name="edi_to_process" string="Electronic invoicing processing needed"/>
        </xpath>
      </field>
    </record>
    <record id="view_move_form_inherit" model="ir.ui.view">
      <field name="name">account.move.form.inherit</field>
      <field name="model">account.move</field>
      <field name="inherit_id" ref="account.view_move_form"/>
      <field name="arch" type="xml">
        <xpath expr="//button[@name='button_cancel']" position="after">
          <field invisible="1" name="edi_show_cancel_button"/>
          <field invisible="1" name="edi_show_abandon_cancel_button"/>
          <field invisible="1" name="edi_show_force_cancel_button"/>
          <button data-hotkey="x" groups="account.group_account_invoice" invisible="not edi_show_cancel_button" name="button_cancel_posted_moves" string="Request EDI Cancellation" type="object"/>
          <button groups="account.group_account_invoice" invisible="not edi_show_abandon_cancel_button" name="button_abandon_cancel_posted_posted_moves" string="Call off EDI Cancellation" type="object"/>
        </xpath>
        <xpath expr="//header" position="after">
          <field invisible="1" name="edi_blocking_level"/>
          <field invisible="1" name="edi_error_count"/>
          <div class="alert alert-info d-flex justify-content-between align-items-center" invisible="edi_web_services_to_process in ['', False] or state == 'draft'" role="alert">
            <div>The invoice will soon be sent to <field class="w-auto" name="edi_web_services_to_process"/></div>
            <button class="oe_link py-0 text-decoration-underline" name="button_process_edi_web_services" string="Process now" type="object"/>
          </div>
          <div class="alert alert-danger" invisible="edi_error_count == 0 or edi_blocking_level != 'error'" role="alert">
            <div class="o_row align-items-center">
              <field name="edi_error_message"/>
              <button confirm="Are you sure you want to cancel this invoice without waiting for the EDI document to be canceled?" groups="account.group_account_invoice" invisible="not edi_show_force_cancel_button" name="button_force_cancel" string="Force Cancel" type="object"/>
              <button class="oe_link" invisible="edi_error_count == 1" name="%(account_edi.action_open_edi_documents)d" string="⇒ See errors" type="action"/>
              <button class="oe_link oe_inline" name="action_retry_edi_documents_error" string="Retry" type="object"/>
            </div>
          </div>
          <div class="alert alert-warning" invisible="edi_error_count == 0 or edi_blocking_level != 'warning'" role="alert">
            <div class="o_row">
              <field name="edi_error_message"/>
              <button class="oe_link" invisible="edi_error_count == 1" name="%(account_edi.action_open_edi_documents)d" string="⇒ See errors" type="action"/>
            </div>
          </div>
          <div class="alert alert-info" invisible="edi_error_count == 0 or edi_blocking_level != 'info'" role="alert">
            <div class="o_row">
              <field name="edi_error_message"/>
              <button class="oe_link" invisible="edi_error_count == 1" name="%(account_edi.action_open_edi_documents)d" string="⇒ See errors" type="action"/>
            </div>
          </div>
        </xpath>
        <xpath expr="//div[@name='journal_div']" position="after">
          <field invisible="not edi_state or state == 'draft'" name="edi_state"/>
        </xpath>
        <xpath expr="//page[@id='other_tab']" position="after">
          <page groups="base.group_no_one" id="edi_documents" invisible="not edi_document_ids" name="page_edi_documents" string="EDI Documents">
            <field name="edi_document_ids">
              <list create="false" decoration-danger="error" delete="false" edit="false" no_open="1">
                <field name="name"/>
                <field name="edi_format_name"/>
                <field name="state"/>
                <field column_invisible="True" name="error"/>
                <field column_invisible="True" name="blocking_level"/>
                <button class="oe_link oe_inline" groups="base.group_no_one" invisible="not error or blocking_level == 'info'" name="action_export_xml" string="Download" type="object"/>
              </list>
            </field>
          </page>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
