<odoo>
    <record id="view_task_list" model="ir.ui.view">
        <field name="name">tasks.task.list</field>
        <field name="model">tasks.task</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="is_done"/>
            </list>
        </field>
    </record>

    <record id="view_task_form" model="ir.ui.view">
        <field name="name">tasks.task.form</field>
        <field name="model">tasks.task</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="is_done"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tasks" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">tasks.task</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_tasks_root" name="Tasks"/>
    <menuitem id="menu_tasks" name="Tasks" parent="menu_tasks_root" action="action_tasks"/>
</odoo>
