<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_cancel_appointment_form" model="ir.ui.view">
    <field name="name">cancel.appointment.wizard.form</field>
    <field name="model">cancel.appointment.wizard</field>
    <field name="arch" type="xml">
      <form>
        <group>
          <field name="appointment_id"/>
          <field name="reason"/>
          <field name="cancellation_date"/>
        </group>
        <footer>
          <button class="btn-primary" data-hotkey="q" name="action_cancel" string="Cancel Appointment" type="object"/>
          <button class="btn-secondary" data-hotkey="x" special="cancel" string="Discard"/>
        </footer>
      </form>
    </field>
  </record>
  <record id="wizard_cancel_appointment_action" model="ir.actions.act_window">
    <field name="name">Cancel Appointment</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">cancel.appointment.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
