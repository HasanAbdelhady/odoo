<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Patient Tree View -->
  <record id="om_hospital_patient_list_view" model="ir.ui.view">
    <field name="name">hospital.patient.list</field>
    <field name="model">hospital.patient</field>
    <field name="arch" type="xml">
      <list export_xlsx="0">
        <field name="name"/>
        <field class="oe_avatar" name="image" options="{'size': [50, 50]}" widget="image"/>
        <field name="birthday"/>
        <field name="gender"/>
        <field name="age"/>
        <field name="ref"/>
        <field name="phone"/>
        <field name="email"/>
        <field name="address"/>
        <field name="state"/>
      </list>
    </field>
  </record>
  <!-- Patient Form View -->
  <record id="om_hospital_patient_form_view" model="ir.ui.view">
    <field name="name">hospital.patient.form</field>
    <field name="model">hospital.patient</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <field class="oe_avatar" name="image" options="{'size': [50, 50]}" widget="image"/>
          <group>
            <div class="oe_title">
              <h4>
                <field name="ref"/>
              </h4>
              <h2>
                <label for="name" string="Name"/>
                <field name="name"/>
              </h2>
            </div>
            <group>
              <field name="birthday"/>
              <field invisible="context.get('in_female_menu')" name="gender"/>
              <field name="age"/>
            </group>
            <group>
              <field name="phone"/>
              <field name="email"/>
              <field name="appointment_count"/>
            </group>
          </group>
          <group>
            <field name="address" readonly="gender == 'male'"/>
            <field name="state"/>
            <field invisible="1" name="active"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="om_hospital_patient_kanban_view" model="ir.ui.view">
    <field name="name">hospital.patient.kanban</field>
    <field name="model">hospital.patient</field>
    <field name="arch" type="xml">
      <kanban>
        <templates>
          <t t-name="card">
            <div class="oe_kanban_global_click">
              <strong class="o_kanban_record_title">
                <field name="name"/>
              </strong>
              <div class="o_kanban_record_body"><field name="image"/> <br/><field name="age"/> years old<br/> <field name="gender"/> <field name="ref"/> <br/> <field name="phone"/><br/> <field name="email"/><br/> <field name="state"/><br/></div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>
  <record id="om_hospital_search_view" model="ir.ui.view">
    <field name="name">om_hospital.patient.search</field>
    <field name="model">hospital.patient</field>
    <field name="arch" type="xml">
      <search string="Search Patients">
        <filter domain="[('gender', '=', 'male')]" name="filter_male" string="Male"/>
        <separator/>
        <filter domain="[('gender', '=', 'female')]" name="filter_female" string="Female"/>
        <separator/>
        <filter domain="[('active', '=', False)]" name="filter_archived" string="Archived"/>
        <separator/>
        <!-- <filter domain="[('age', '&lt;=', 17)]" name="filter_is_child" string="Is a Child"/> -->
        <filter context="{'group_by': 'gender'}" name="group_by_gender" string="Gender"/>
        <filter context="{'group_by': 'state'}" name="group_by_state" string="State"/>
        <field filter_domain="['|','|','|',('name','ilike',self),('gender','ilike',self),('age','ilike',self),('phone','ilike',self)]" name="name"/>
        <field name="gender"/>
        <field name="age"/>
        <field name="phone"/>
        <field name="state"/>
        <searchpanel>
          <field enable_counters="1" icon="fa-users" name="gender" string="Gender"/>
          <field enable_counters="1" icon="fa-users" name="state" string="State"/>
        </searchpanel>
      </search>
    </field>
  </record>
  <!-- Patient Action -->
  <record id="om_hospital_patient_action" model="ir.actions.act_window">
    <field name="name">Patients</field>
    <field name="res_model">hospital.patient</field>
    <field name="view_mode">list,form,kanban</field>
    <field name="context">{'search_default_filter_male':1, 'search_default_group_by_state':1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create your first patient!</p>
    </field>
  </record>
  <!-- LinkedIn URL Action -->
  <record id="om_hospital_hasan_linkedin_action" model="ir.actions.act_url">
    <field name="name">Hasan's LinkedIn</field>
    <field name="url">https://linkedin.com/in/hasan-abdelhady</field>
    <field name="target">new</field>
  </record>
</odoo>
