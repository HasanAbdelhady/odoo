<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- appointment Tree View -->
  <record id="om_hospital_appointment_list_view" model="ir.ui.view">
    <field name="name">hospital.appointment.list</field>
    <field name="model">hospital.appointment</field>
    <field name="arch" type="xml">
      <list decoration-danger="status == 'cancelled'" decoration-muted="status == 'draft'" decoration-success="status == 'done'" decoration-warning="status == 'in_consultation'" multi_edit="1" sample="1">
        <field name="patient_id" width="200"/>
        <field name="appointment_time" width="200"/>
        <field name="booking_date" optional="hide" width="200"/>
        <field name="priority" width="100"/>
        <field name="activity_ids" optional="show" widget="list_activity" width="100"/>
        <field name="gender" optional="show"/>
        <field name="ref" optional="hide"/>
        <field name="doctor_id" widget="many2one_avatar_user"/>
        <field decoration-danger="status == 'cancelled'" decoration-muted="status == 'draft'" decoration-success="status == 'done'" decoration-warning="status == 'in_consultation'" name="status" widget="badge" width="100"/>
      </list>
    </field>
  </record>
  <!-- appointment Form View -->
  <record id="om_hospital_appointment_form_view" model="ir.ui.view">
    <field name="name">hospital.appointment.form</field>
    <field name="model">hospital.appointment</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button data-hotkey="s" invisible="status == 'draft'" name="reset_to_draft" string="Reset" type="object"/>
          <button class="btn btn-warning" data-hotkey="x" invisible="status !='draft'" name="consultation" string="Consultation" type="object"/>
          <button class="oe_highlight" data-hotkey="d" invisible="status != 'in_consultation'" name="done" string="Done" type="object"/>
          <button class="btn btn-danger" invisible="status == 'cancelled'" name="cancel_appointment" string="Cancel Appointment" type="object"/>
          <field name="status" nolabel="1" statusbar_visible="draft, in_consultation, done" widget="statusbar"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1>
              <field class="mr-3" name="priority" widget="priority"/>
            </h1>
          </div>
          <group>
            <group>
              <field default_focus="1" name="patient_id"/>
              <field default_focus="1" name="booking_date"/>
              <field name="gender"/>
              <field name="ref"/>
              <field name="doctor_id" widget="many2one_avatar_user"/>
            </group>
            <group>
              <field name="appointment_time"/>
              <button confirm="Are you sure you want to go to Patients?" help="Go to patients menu" name="%(om_hospital_patient_action)d" string="Patients Menu" type="action"/>
            </group>
          </group>
          <notebook>
            <page name="prescription" string="Prescription">
              <group>
                <field name="prescription" options="{'collaborative':true,'style-inline': true,'height': 400,'codeview': true }" placeholder="Enter your prescription"/>
              </group>
            </page>
            <page name="pharmacy" string="Pharmacy">
              <field name="pharmacy_line_ids">
                <list editable="bottom">
                  <field name="product_id"/>
                  <field name="unit_price"/>
                  <field name="qty"/>
                  <field name="total_price"/>
                </list>
                <form>
                  <group>
                    <field name="product_id"/>
                    <field name="unit_price"/>
                    <field name="qty"/>
                    <field name="total_price"/>
                  </group>
                </form>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="om_hospital_appointment_kanban_view" model="ir.ui.view">
    <field name="name">hospital.appointment.kanban</field>
    <field name="model">hospital.appointment</field>
    <field name="arch" type="xml">
      <kanban decoration-danger="status == 'cancelled'" decoration-muted="status == 'draft'" decoration-success="status == 'done'" decoration-warning="status == 'in_consultation'" sample="1">
        <field name="status"/>
        <field name="priority"/>
        <field name="patient_id"/>
        <templates>
          <t t-name="card">
            <div class="oe_kanban_global_click">
              <strong class="o_kanban_record_title">
                <field name="patient_id"/>
              </strong>
              <br/>
              <field name="gender"/>
              <br/>
              <field decoration-danger="status == 'cancelled'" decoration-muted="status == 'draft'" decoration-success="status == 'done'" decoration-warning="status == 'in_consultation'" name="status" widget="badge" width="100"/>
              <br/>
              <field class="mr-3" name="priority" widget="priority"/>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>
  <record id="hospital_appointment_search_view" model="ir.ui.view">
    <field name="name">om_hospital.appointment.search</field>
    <field name="model">hospital.appointment</field>
    <field name="arch" type="xml">
      <search string="Search appointments">
        <filter context="{'group_by': 'status'}" name="group_by_status" string="Status"/>
      </search>
    </field>
  </record>
  <!-- appointment Action -->
  <record id="om_hospital_appointment_action" model="ir.actions.act_window">
    <field name="name">appointments</field>
    <field name="res_model">hospital.appointment</field>
    <field name="view_mode">list,form,kanban</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create your first appointment!</p>
    </field>
  </record>
</odoo>
