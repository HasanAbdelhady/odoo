<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="hospital_operation_list_view" model="ir.ui.view">
    <field name="name">hospital.operation.list</field>
    <field name="model">hospital.operation</field>
    <field name="type">list</field>
    <field name="arch" type="xml">
      <list>
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="doctor_id"/>
      </list>
    </field>
  </record>
  <record id="hospital_operation_form_view" model="ir.ui.view">
    <field name="name">hospital.operation.form</field>
    <field name="model">hospital.operation</field>
    <field name="type">form</field>
    <field name="arch" type="xml">
      <form>
        <group>
          <field name="name"/>
          <field name="doctor_id"/>
        </group>
      </form>
    </field>
  </record>
  <record id="hospital_operation_action" model="ir.actions.act_window">
    <field name="name">Hospital Operation</field>
    <field name="res_model">hospital.operation</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create your first operation!</p>
    </field>
  </record>
</odoo>
