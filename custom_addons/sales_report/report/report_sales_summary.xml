<odoo>
  <template id="report_sales_summary">
    <t t-call="web.html_container">
      <t t-as="doc" t-foreach="docs">
        <div class="page">
          <h2>Sales Report</h2>
          <p>From <t t-esc="doc.start_date"/> to <t t-esc="doc.end_date"/></p>
          <h3>Most Sold Products</h3>
          <table class="table table-sm">
            <thead>
              <tr>
                <th>Product</th>
                <th>Quantity Sold</th>
              </tr>
            </thead>
            <tbody>
              <t t-as="line" t-foreach="doc.get_most_sold_products()">
                <tr>
                  <td>
                    <t t-esc="line['product']"/>
                  </td>
                  <td>
                    <t t-esc="line['quantity']"/>
                  </td>
                </tr>
              </t>
            </tbody>
          </table>
          <h3>Least Sold Products</h3>
          <table class="table table-sm">
            <thead>
              <tr>
                <th>Product</th>
                <th>Quantity Sold</th>
              </tr>
            </thead>
            <tbody>
              <t t-as="line" t-foreach="doc.get_least_sold_products()">
                <tr>
                  <td>
                    <t t-esc="line['product']"/>
                  </td>
                  <td>
                    <t t-esc="line['quantity']"/>
                  </td>
                </tr>
              </t>
            </tbody>
          </table>
          <h3>Top Salespeople</h3>
          <table class="table table-sm">
            <thead>
              <tr>
                <th>Salesperson</th>
                <th>Total Sales</th>
              </tr>
            </thead>
            <tbody>
              <t t-as="line" t-foreach="doc.get_top_salespeople()">
                <tr>
                  <td>
                    <t t-esc="line['user']"/>
                  </td>
                  <td>
                    <t t-esc="line['total']"/>
                  </td>
                </tr>
              </t>
            </tbody>
          </table>
        </div>
      </t>
    </t>
  </template>
</odoo>
