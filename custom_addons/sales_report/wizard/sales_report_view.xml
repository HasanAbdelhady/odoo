<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_sales_report_form" model="ir.ui.view">
    <field name="name">sales.report.wizard</field>
    <field name="model">sales.report.wizard</field>
    <field name="arch" type="xml">
      <form>
        <group>
          <field name="start_date"/>
          <field name="end_date"/>
        </group>
        <footer>
          <button class="btn-primary" data-hotkey="q" name="action_show" string="Show" type="object"/>
          <button class="btn-secondary" data-hotkey="x" special="cancel" string="Discard"/>
        </footer>
      </form>
    </field>
  </record>
  <record id="sales_report_wizard_action" model="ir.actions.act_window">
    <field name="name">Sales Report</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">sales.report.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
