<odoo>
  <record id="view_move_form_inherit_so_confirmed_user" model="ir.ui.view">
    <field name="name">account.move.form.inherit.so.confirmed.user</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <!-- Put the field right after the invoice date -->
      <xpath expr="//field[@name='invoice_date']" position="after">
        <field name="so_confirmed_user_id"/>
      </xpath>
    </field>
  </record>
</odoo>
