<odoo>
  <record id="view_move_form" model="ir.ui.view">
    <field name="name">account.move.form.inherit</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <!-- Put the field right after the invoice date -->
      <xpath expr="//field[@name='invoice_date']" position="after">
        <field name="so_confirmed_user_id"/>
      </xpath>
      <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="before">
        <field name="line_number"/>
      </xpath>
      <xpath expr="//field[@name='invoice_line_ids']/form/sheet/group/field[@name='product_id']" position="before">
        <field name="line_number"/>
      </xpath>
    </field>
  </record>
</odoo>
