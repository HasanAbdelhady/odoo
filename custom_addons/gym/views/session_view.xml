<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- session Tree View -->
  <record id="gym_session_list_view" model="ir.ui.view">
    <field name="name">gym.session.list</field>
    <field name="model">gym.session</field>
    <field name="arch" type="xml">
      <list multi_edit="1" sample="1">
        <field name="session_title"/>
        <field name="coach_id"/>
        <field name="coach_image" options="{'size': [50, 50]}" string="Coach Photo" widget="image"/>
        <field name="coach_phone" string="Coach Phone"/>
        <field name="trainee_id"/>
        <field name="trainee_image" options="{'size': [50, 50]}" string="Trainee Photo" widget="image"/>
        <field name="trainee_phone" string="Trainee Phone"/>
        <field name="session_start_time" string="Session Start Time"/>
        <field name="session_end_time" string="Session End Time"/>
        <field name="is_attended_by_coach"/>
        <field name="is_attended_by_trainee"/>
      </list>
    </field>
  </record>
  <!-- session Form View -->
  <record id="gym_session_form_view" model="ir.ui.view">
    <field name="name">gym.session.form</field>
    <field name="model">gym.session</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="session_title"/>
              <field name="session_start_time" string="Session Start Time"/>
              <field name="session_end_time" string="Session End Time"/>
              <field name="session_cost" string="Session Cost"/>
            </group>
            <group>
              <field name="coach_id"/>
              <field name="coach_image" options="{'size': [50, 50]}" string="Coach Photo" widget="image"/>
              <field name="coach_phone" string="Coach Phone"/>
            </group>
            <group>
              <field name="trainee_id"/>
              <field name="trainee_image" options="{'size': [50, 50]}" string="Trainee Photo" widget="image"/>
              <field name="trainee_phone" string="Trainee Phone"/>
            </group>
            <group>
              <field name="is_attended_by_coach"/>
              <field name="is_attended_by_trainee"/>
            </group>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="gym_session_kanban_view" model="ir.ui.view">
    <field name="name">gym.session.kanban</field>
    <field name="model">gym.session</field>
    <field name="arch" type="xml">
      <kanban>
        <templates>
          <t t-name="card">
            <div class="oe_kanban_global_click">
              <strong class="o_kanban_record_title">Coach: <field name="coach_id"/> <br/>Trainee: <field name="trainee_id"/></strong>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>
  <!-- session Search View -->
  <record id="gym_session_action" model="ir.actions.act_window">
    <field name="name">sessions</field>
    <field name="res_model">gym.session</field>
    <field name="view_mode">list,form,kanban</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Add your first session!</p>
    </field>
  </record>
</odoo>
