          <!--       </group> -->
          <!--       <group string="Outside Working Hours (Overtime)"> -->
          <!--         <field name="trainer_percentage_out_time" widget="percentage"/> -->
          <!--         <field name="trainer_amount_out_time" readonly="1" string="Amount per Hour"/> -->
          <!--       </group> -->
          <!--     </group> -->
          <!--     <group> -->
          <!--       <div class="alert alert-info" role="alert"><strong>How it works:</strong><br/> • Trainer compensation is calculated as a percentage of the session price<br/> • Different percentages apply for standard hours vs overtime<br/> • The system automatically detects if a session is during coach's working hours</div> -->
          <!--     </group> -->
