      </form>
    </field>
  </record> <!-- Action for Gym Session Products --><record id="action_gym_session_products" model="ir.actions.act_window">
    <field name="name">Session Products</field>
    <field name="res_model">product.template</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="product_template_gym_only_form"/>
    <field name="domain">[('is_gym_membership', '=', True)]</field>
    <field name="context">{ 'default_type': 'service', 'default_sale_ok': True, 'default_purchase_ok': False }</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create your first gym session product!</p>
      <p>Session products define the pricing and trainer compensation for different types of sessions.</p>
    </field>
  </record></odoo>
