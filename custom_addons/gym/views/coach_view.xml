<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- coach list View -->
  <record id="gym_coach_list_view" model="ir.ui.view">
    <field name="name">gym.coach.list</field>
    <field name="model">gym.coach</field>
    <field name="arch" type="xml">
      <list>
        <field class="oe_avatar" name="coach_image" options="{'size': [50, 50]}" widget="image"/>
        <field name="name"/>
        <field name="phone_number"/>
        <field name="coach_cost_per_hour_normal"/>
        <field name="coach_cost_per_hour_overtime"/>
        <field name="schedule_ids"/>
      </list>
    </field>
  </record>
  <!-- coach Form View -->
  <record id="gym_coach_form_view" model="ir.ui.view">
    <field name="name">gym.coach.form</field>
    <field name="model">gym.coach</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <!-- Avatar in top-left corner -->
          <field class="oe_avatar" name="coach_image" options="{'preview_image': 'coach_image', 'size': [90, 90]}" widget="image"/>
          <!-- Title section -->
          <div class="oe_title">
            <h1>
              <field name="name" placeholder="coach Name"/>
            </h1>
          </div>
          <!-- Form fields -->
          <group>
            <group>
              <field name="coach_id"/>
              <field name="phone_number"/>
            </group>
            <group>
              <field name="coach_cost_per_hour_normal"/>
              <field name="coach_cost_per_hour_overtime"/>
            </group>
          </group>
          <notebook>
            <page name="schedule" string="Weekly Schedule">
              <field name="schedule_ids">
                <list editable="bottom">
                  <field name="day_of_week"/>
                  <field name="time_from" widget="float_time"/>
                  <field name="time_to" widget="float_time"/>
                  <field name="time_display"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="gym_coach_kanban_view" model="ir.ui.view">
    <field name="name">gym.coach.kanban</field>
    <field name="model">gym.coach</field>
    <field name="arch" type="xml">
      <kanban>
        <templates>
          <t t-name="card">
            <div class="oe_kanban_global_click">
              <strong class="o_kanban_record_title">
                <field class="oe_avatar" name="coach_image" options="{'size': [50, 50]}" widget="image"/>
                <field name="name"/>
              </strong>
              <div class="o_kanban_record_body">Phone Number: <field name="phone_number"/> <br/> coach ID: <field name="coach_id"/>"/></div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>
  <!-- coach Action -->
  <record id="gym_coach_action" model="ir.actions.act_window">
    <field name="name">coachs</field>
    <field name="res_model">gym.coach</field>
    <field name="view_mode">list,form,kanban</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Add your first coach!</p>
    </field>
  </record>
</odoo>
