<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- trainee Tree View -->
  <record id="gym_trainee_list_view" model="ir.ui.view">
    <field name="name">gym.trainee.list</field>
    <field name="model">gym.trainee</field>
    <field name="arch" type="xml">
      <list>
        <field name="trainee_image" widget="image" class="oe_avatar" options="{'size': [50, 50]}"/>
        <field name="name"/>
        <field name="phone_number"/>
        <field name="trainer_name"/>
      </list>
    </field>
  </record>
  <!-- trainee Form View -->
  <record id="gym_trainee_form_view" model="ir.ui.view">
    <field name="name">gym.trainee.form</field>
    <field name="model">gym.trainee</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <!-- Avatar in top-left corner -->
          <field name="trainee_image" widget="image" class="oe_avatar" options="{'preview_image': 'trainee_image', 'size': [90, 90]}"/>
          
          <!-- Title section -->
          <div class="oe_title">
            <h1>
              <field name="name" placeholder="Trainee Name"/>
            </h1>
          </div>
          
          <!-- Form fields -->
          <group>
            <group>
              <field name="trainee_id"/>
              <field name="phone_number"/>
            </group>
            <group>
              <field name="trainer_name"/>
            </group>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="gym_trainee_kanban_view" model="ir.ui.view">
    <field name="name">gym.trainee.kanban</field>
    <field name="model">gym.trainee</field>
    <field name="arch" type="xml">
      <kanban>
        <templates>
          <t t-name="card">
            <div class="oe_kanban_global_click">
              <strong class="o_kanban_record_title">
                <field name="trainee_image" widget="image" class="oe_avatar" options="{'size': [50, 50]}"/>
                <field name="name"/>
              </strong>
              <div class="o_kanban_record_body">Phone Number: <field name="phone_number"/> <br/> Trainee ID: <field name="trainee_id"/> <br/> Trainer: <field name="trainer_name"/></div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>
  <!-- trainee Action -->
  <record id="gym_trainee_action" model="ir.actions.act_window">
    <field name="name">trainees</field>
    <field name="res_model">gym.trainee</field>
    <field name="view_mode">list,form,kanban</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Add your first trainee!</p>
    </field>
  </record>
</odoo>
