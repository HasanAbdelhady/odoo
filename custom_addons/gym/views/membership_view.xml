<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- membership Tree View -->
  <record id="gym_membership_list_view" model="ir.ui.view">
    <field name="name">gym.membership.list</field>
    <field name="model">gym.membership</field>
    <field name="arch" type="xml">
      <list>
        <field name="coach_id"/>
        <field name="coach_image" options="{'size': [50, 50]}" string="Coach Photo" widget="image"/>
        <field name="coach_phone" string="Coach Phone"/>
        <field name="trainee_id"/>
        <field name="trainee_image" options="{'size': [50, 50]}" string="Trainee Photo" widget="image"/>
        <field name="trainee_phone" string="Trainee Phone"/>
      </list>
    </field>
  </record>
  <!-- membership Form View -->
  <record id="gym_membership_form_view" model="ir.ui.view">
    <field name="name">gym.membership.form</field>
    <field name="model">gym.membership</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="coach_id"/>
              <field name="coach_image" options="{'size': [50, 50]}" string="Coach Photo" widget="image"/>
              <field name="coach_phone" string="Coach Phone"/>
            </group>
            <group>
              <field name="trainee_id"/>
              <field name="trainee_image" options="{'size': [50, 50]}" string="Trainee Photo" widget="image"/>
              <field name="trainee_phone" string="Trainee Phone"/>
            </group>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="gym_membership_kanban_view" model="ir.ui.view">
    <field name="name">gym.membership.kanban</field>
    <field name="model">gym.membership</field>
    <field name="arch" type="xml">
      <kanban>
        <templates>
          <t t-name="card">
            <div class="oe_kanban_global_click">
              <strong class="o_kanban_record_title">Coach: <field name="coach_id"/> <br/> Trainee: <field name="trainee_id"/></strong>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>
  <!-- membership Action -->
  <record id="gym_membership_action" model="ir.actions.act_window">
    <field name="name">Memberships</field>
    <field name="res_model">gym.membership</field>
    <field name="view_mode">list,form,kanban</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Add your first membership!</p>
    </field>
  </record>
</odoo>
