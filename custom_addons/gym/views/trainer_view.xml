<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- trainer Tree View -->
  <record id="gym_trainer_list_view" model="ir.ui.view">
    <field name="name">gym.trainer.list</field>
    <field name="model">gym.trainer</field>
    <field name="arch" type="xml">
      <list>
        <field name="trainer_image" widget="image" class="oe_avatar" options="{'size': [50, 50]}"/>
        <field name="name"/>
        <field name="phone_number"/>
        <field name="trainee_count"/>
      </list>
    </field>
  </record>
  <!-- trainer Form View -->
  <record id="gym_trainer_form_view" model="ir.ui.view">
    <field name="name">gym.trainer.form</field>
    <field name="model">gym.trainer</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <!-- Avatar in top-left corner -->
          <field name="trainer_image" widget="image" class="oe_avatar" options="{'preview_image': 'trainer_image', 'size': [90, 90]}"/>
          
          <!-- Title section -->
          <div class="oe_title">
            <h1>
              <field name="name" placeholder="Trainer Name"/>
            </h1>
          </div>
          
          <!-- Form fields -->
          <group>
            <group>
              <field name="trainer_id"/>
              <field name="phone_number"/>
            </group>
            <group>
              <field name="trainee_count"/>
            </group>
          </group>
          
          <!-- Trainees list in notebook -->
          <notebook>
            <page name="trainees" string="Trainees">
              <field name="trainee_ids">
                <list editable="bottom">
                  <field name="name"/>
                  <field name="trainee_id"/>
                  <field name="phone_number"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="gym_trainer_kanban_view" model="ir.ui.view">
    <field name="name">gym.trainer.kanban</field>
    <field name="model">gym.trainer</field>
    <field name="arch" type="xml">
      <kanban>
        <templates>
          <t t-name="card">
            <div class="oe_kanban_global_click">
              <strong class="o_kanban_record_title">
                <field name="trainer_image" widget="image" class="oe_avatar" options="{'size': [50, 50]}"/>
                <field name="name"/>
              </strong>
              <div class="o_kanban_record_body">Phone Number: <field name="phone_number"/> <br/> Trainer ID: <field name="trainer_id"/> <br/> Trainees Count: <field name="trainee_count"/></div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>
  <!-- trainer Action -->
  <record id="gym_trainer_action" model="ir.actions.act_window">
    <field name="name">trainers</field>
    <field name="res_model">gym.trainer</field>
    <field name="view_mode">list,form,kanban</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Add your first trainer!</p>
    </field>
  </record>
</odoo>
